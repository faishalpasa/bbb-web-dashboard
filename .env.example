# Admin SPA uses localhost:5174; member SPA stays at localhost:5173.
# API integration requires both origins in CORS_ALLOWED_ORIGINS and SANCTUM_STATEFUL_DOMAINS.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_ORIGIN=http://localhost:8000
VITE_API_MOCKING_ENABLED=false
# Member/public web app origin; public event pages open at <this>/e/{slug}.
VITE_PUBLIC_WEB_URL=http://localhost:5173
